# Environment Configuration (Optional)
# The pipeline operates 100% locally and deterministically using TF-IDF + MiniLM + FAISS.
# Setting an API key enables optional structured LLM fallback and GPT-4o-mini rubric judging.

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Confidence Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.35
RETRIEVAL_SIMILARITY_THRESHOLD=0.45
